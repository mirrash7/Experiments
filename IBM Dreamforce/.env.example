# Copy to .env in this folder and fill in. Never commit the real .env.
# Key for the workspace that owns the demo models (jenniferworkspace).
ROBOFLOW_API_KEY_JENNIFER=
# Optional: only needed if you re-run detections live instead of using the caches,
# or use the older alexei-alexandrovich models.
ROBOFLOW_API_KEY=
# Optional: POST work orders to a real endpoint instead of the built-in inbox.
SF_WEBHOOK_URL=
