# OPTIONAL. The demo runs without any of these: detections for both flights are
# pre-computed into app/cache/*.json, so playing a flight never calls the API.
#
# You only need a key to:
#   - use the "Upload" button on your own video (no cache -> live inference), or
#   - re-run scripts/precompute.py after changing a model or a clip.
#
# Key for the workspace that owns the demo models (jenniferworkspace).
ROBOFLOW_API_KEY_JENNIFER=
# Only for the older alexei-alexandrovich models.
ROBOFLOW_API_KEY=
# POST work orders to a real endpoint instead of the built-in inbox.
SF_WEBHOOK_URL=
