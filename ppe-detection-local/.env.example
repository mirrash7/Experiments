# Copy to .env and fill in. Never commit the real .env.
# Get a Roboflow API key at app.roboflow.com/settings/api (model:infer scope is enough).
ROBOFLOW_API_KEY=your_key_here

# Optional: real email delivery for the photobooth (otherwise strips queue to outbox/)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your_app_password
